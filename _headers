# Long-cache immutable assets (content is versioned via git, path changes on update)
/sprites/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate entry point
/index.html
  Cache-Control: no-cache
